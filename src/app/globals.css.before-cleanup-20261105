  color: #8b6f40;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .15em;
  text-transform: uppercase;
}

.contact-details strong {
  color: var(--brand-green-deep);
  font-family: var(--font-serif), Georgia, serif;
  font-size: 28px;
  font-weight: 500;
}

.contact-details p {
  margin-top: 5px;
  color: var(--muted);
}

.contact-form-section,
.interest-form-section {
  padding: 95px 8vw;
  display: grid;
  grid-template-columns: .85fr 1.15fr;
  gap: 100px;
  background: var(--brand-white);
}

.church-form {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 22px;
}

.church-form label {
  display: flex;
  flex-direction: column;
  gap: 9px;
  color: var(--brand-green-deep);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .06em;
  text-transform: uppercase;
}

.church-form input,
.church-form select,
.church-form textarea {
  width: 100%;
  padding: 15px 16px;
  background: var(--brand-cream);
  border: 1px solid rgba(23,53,45,.18);
  color: var(--brand-charcoal);
  font-family: var(--font-sans), Arial, sans-serif;
  font-size: 15px;
  font-weight: 400;
  text-transform: none;
  outline: none;
}

.church-form input:focus,
.church-form select:focus,
.church-form textarea:focus {
  border-color: #9c7d4d;
}

.church-form textarea {
  resize: vertical;
}

.form-submit-button {
  width: fit-content;
  padding: 17px 28px;
  background: var(--brand-green-deep);
  border: 1px solid var(--brand-green-deep);
  color: white;
  cursor: pointer;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.form-submit-button:hover {
  background: var(--brand-gold);
  border-color: var(--brand-gold);
  color: var(--brand-green-deep);
}

.contact-next-steps,
.prayer-section {
  padding: 85px 9vw;
  display: grid;
  grid-template-columns: 1.25fr 1fr;
  gap: 80px;
  align-items: end;
  color: white;
  background: var(--brand-green-deep);
}

.contact-next-steps h2,
.prayer-section h2 {
  font-family: var(--font-serif), Georgia, serif;
  font-size: clamp(3rem, 4.7vw, 5.2rem);
  font-weight: 500;
  line-height: .98;
}

.contact-next-steps h2 span,
.prayer-section h2 span {
  display: block;
  color: var(--brand-gold-soft);
  font-style: italic;
  font-weight: 400;
}

.contact-next-steps > div:last-child p,
.prayer-section > div:last-child p {
  margin-bottom: 27px;
  color: rgba(255,255,255,.74);
  line-height: 1.8;
}


/* =========================================================
   GET INVOLVED
   ========================================================= */

.involvement-grid-section {
  padding: 90px 8vw;
  background: var(--brand-cream);
}

.involvement-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  border-top: 1px solid rgba(23,53,45,.15);
  border-left: 1px solid rgba(23,53,45,.15);
}

.involvement-card {
  min-height: 270px;
  padding: 38px;
  border-right: 1px solid rgba(23,53,45,.15);
  border-bottom: 1px solid rgba(23,53,45,.15);
  background: rgba(255,255,255,.2);
}

.involvement-card h3 {
  font-family: var(--font-serif), Georgia, serif;
  font-size: 34px;
  font-weight: 500;
}

.involvement-card p {
  margin-top: 18px;
  color: var(--muted);
  line-height: 1.75;
}

.involvement-feature {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  background: var(--brand-white);
}

.involvement-feature-image img {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 560px;
  object-fit: cover;
}

.involvement-feature-copy {
  padding: 80px 8vw;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.involvement-feature-copy h2 {
  font-family: var(--font-serif), Georgia, serif;
  font-size: clamp(3rem, 4.6vw, 5rem);
  font-weight: 500;
  line-height: 1;
}

.involvement-feature-copy h2 span {
  display: block;
  color: #9c7d4d;
  font-style: italic;
  font-weight: 400;
}

.involvement-feature-copy > p:not(.eyebrow) {
  margin-top: 24px;
  color: var(--muted);
  line-height: 1.8;
}

.involvement-feature-copy a {
  margin-top: 26px;
  font-size: 12px;
  font-weight: 700;
}


/* =========================================================
   CONTACT / INVOLVEMENT RESPONSIVE
   ========================================================= */

@media (max-width: 950px) {
  .contact-intro,
  .contact-form-section,
  .interest-form-section,
  .contact-next-steps,
  .prayer-section,
  .involvement-feature {
    grid-template-columns: 1fr;
  }

  .involvement-grid {
    grid-template-columns: 1fr;
  }

  .contact-intro,
  .contact-form-section,
  .interest-form-section {
    gap: 55px;
  }
}

@media (max-width: 650px) {
  .contact-intro,
  .contact-form-section,
  .interest-form-section,
  .involvement-grid-section {
    padding-left: 7vw;
    padding-right: 7vw;
  }

  .form-row {
    grid-template-columns: 1fr;
  }

  .contact-next-steps,
  .prayer-section {
    padding: 70px 7vw;
    gap: 38px;
  }

  .involvement-feature-copy {
    padding: 65px 7vw;
  }

  .involvement-feature-image img {
    min-height: 380px;
  }
}

