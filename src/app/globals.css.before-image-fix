/* =========================================================
   PLACEHOLDER PHOTOGRAPHY
   ========================================================= */

.hero-background {
  background-size: cover !important;
  background-position: center center !important;
  background-repeat: no-repeat !important;
}

.worship-image {
  position: relative;
  overflow: hidden;
  padding: 0;
  min-height: 100%;
}

.worship-photo {
  width: 100%;
  height: 100%;
  min-height: 520px;
  display: block;
  object-fit: cover;
  object-position: center;
}

@media (max-width: 950px) {
  .worship-photo {
    min-height: 440px;
  }
}

@media (max-width: 650px) {
  .worship-photo {
    min-height: 340px;
  }
}
