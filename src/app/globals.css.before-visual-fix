:root {
  --background: #f4f0e8;
  --surface: #ebe5da;
  --ink: #17221c;
  --muted: #667169;
  --forest: #1e3329;
  --forest-light: #30493b;
  --gold: #c9a66b;
  --cream: #f8f4ec;
  --line: rgba(23, 34, 28, 0.14);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  background: var(--background);
  color: var(--ink);
  font-family: var(--font-sans), Arial, sans-serif;
}

a {
  color: inherit;
  text-decoration: none;
}

main {
  overflow: hidden;
}

.hero {
  position: relative;
  min-height: 100svh;
  display: flex;
  align-items: center;
  color: white;
  isolation: isolate;
}

.hero-background {
  position: absolute;
  inset: -8%;
  z-index: -3;
  background:
    radial-gradient(circle at 65% 40%, rgba(201, 166, 107, 0.18), transparent 28%),
    linear-gradient(135deg, #1b2a23 0%, #30483a 42%, #17221c 100%);
  transform: scale(1.1);
}

.hero-background::after {
  content: "";
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px);
  background-size: 60px 60px;
}

.hero-overlay {
  position: absolute;
  inset: 0;
  z-index: -2;
  background:
    linear-gradient(90deg, rgba(8, 15, 11, 0.72), rgba(8, 15, 11, 0.22)),
    linear-gradient(0deg, rgba(8, 15, 11, 0.22), transparent 40%);
}

.site-header {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 105px;
  padding: 0 5vw;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid rgba(255, 255, 255, 0.16);
  z-index: 10;
}

.brand {
  display: flex;
  align-items: center;
  gap: 14px;
}

.brand-mark {
  color: var(--gold);
  font-size: 28px;
}

.brand strong,
.brand small {
  display: block;
}

.brand strong {
  font-family: var(--font-serif), Georgia, serif;
  font-size: 23px;
  font-weight: 600;
}

.brand small {
  margin-top: 3px;
  font-size: 9px;
  letter-spacing: 0.18em;
  opacity: 0.7;
}

.desktop-nav {
  display: flex;
  gap: 30px;
  font-size: 13px;
}

.desktop-nav a {
  opacity: 0.85;
  transition: opacity 0.25s ease;
}

.desktop-nav a:hover {
  opacity: 1;
}

.header-button {
  border: 1px solid rgba(255,255,255,.55);
  padding: 13px 20px;
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.hero-content {
  width: min(1120px, 90vw);
  margin: 70px auto 0;
}

.eyebrow {
  margin-bottom: 24px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.25em;
  color: var(--gold);
}

.eyebrow.dark {
  color: #836b45;
}

.hero h1,
.intro-section h2,
.section-heading h2,
.missions-content h2,
.worship-content h2,
.giving-section h2,
.visit-section h2 {
  font-family: var(--font-serif), Georgia, serif;
  font-weight: 500;
  line-height: 0.92;
}

.hero h1 {
  max-width: 900px;
  font-size: clamp(4rem, 8vw, 8.5rem);
}

.hero h1 span,
.intro-section h2 span,
.missions-content h2 span,
.worship-content h2 span,
.giving-section h2 span,
.visit-section h2 span {
  display: block;
  font-style: italic;
  font-weight: 400;
}

.hero h1 span {
  color: #e4cfaa;
}

.hero-copy {
  max-width: 580px;
  margin-top: 34px;
  font-size: 17px;
  line-height: 1.7;
  color: rgba(255,255,255,.78);
}

.hero-actions {
  display: flex;
  align-items: center;
  gap: 34px;
  margin-top: 36px;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 54px;
  padding: 0 26px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: 11px;
  font-weight: 700;
}

.primary-button {
  background: var(--gold);
  color: #152018;
}

.text-button {
  font-size: 13px;
}

.text-button span {
  margin-left: 8px;
}

.scroll-indicator {
  position: absolute;
  right: 4vw;
  bottom: 40px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}

.scroll-indicator span {
  writing-mode: vertical-rl;
  font-size: 8px;
  letter-spacing: .3em;
  opacity: .6;
}

.scroll-line {
  width: 1px;
  height: 55px;
  background: rgba(255,255,255,.4);
}

.service-strip {
  min-height: 130px;
  padding: 30px 6vw;
  background: var(--cream);
  display: grid;
  grid-template-columns: 1fr 1fr 1.4fr auto;
  align-items: center;
  gap: 30px;
  border-bottom: 1px solid var(--line);
}

.service-strip div {
  border-right: 1px solid var(--line);
}

.service-strip span,
.service-strip strong {
  display: block;
}

.service-label {
  margin-bottom: 7px;
  font-size: 9px;
  letter-spacing: .16em;
  color: var(--muted);
}

.service-strip strong {
  font-family: var(--font-serif), Georgia, serif;
  font-size: 21px;
  font-weight: 600;
}

.service-strip > a {
  font-size: 12px;
  font-weight: 700;
}

.intro-section {
  position: relative;
  padding: 150px 8vw;
  display: grid;
  grid-template-columns: .5fr 2fr 1fr;
  gap: 70px;
}

.section-number {
  font-family: var(--font-serif), Georgia, serif;
  font-size: 72px;
  color: rgba(23,34,28,.1);
}

.intro-section h2 {
  max-width: 700px;
  font-size: clamp(3rem, 5.5vw, 6rem);
}

.intro-section h2 span {
  color: #8e7450;
}

.intro-copy {
  padding-top: 60px;
}

.intro-copy p {
  margin-bottom: 22px;
  color: var(--muted);
  line-height: 1.8;
  font-size: 15px;
}

.intro-copy a,
.worship-content a {
  display: inline-block;
  margin-top: 15px;
  font-size: 12px;
  font-weight: 700;
}

.ministries-section,
.events-section {
  padding: 120px 8vw;
  background: var(--surface);
}

.section-heading {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 50px;
  margin-bottom: 70px;
}

.section-heading h2 {
  font-size: clamp(3rem, 5vw, 5.5rem);
}

.section-heading > p {
  max-width: 470px;
  color: var(--muted);
  line-height: 1.7;
}

.ministry-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-top: 1px solid var(--line);
}

.ministry-card {
  min-height: 350px;
  padding: 38px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  border-right: 1px solid var(--line);
  transition:
    transform .35s ease,
    background .35s ease;
}

.ministry-card:last-child {
  border-right: 0;
}

.ministry-card:hover {
  background: var(--cream);
  transform: translateY(-8px);
}

.card-number {
  font-family: var(--font-serif), Georgia, serif;
  color: #927954;
}

.ministry-card h3 {
  margin-bottom: 16px;
  font-family: var(--font-serif), Georgia, serif;
  font-size: 35px;
  font-weight: 500;
}

.ministry-card p {
  color: var(--muted);
  line-height: 1.7;
}

.ministry-card a {
  font-size: 12px;
  font-weight: 700;
}

.missions-parallax {
  position: relative;
  min-height: 850px;
  display: flex;
  align-items: center;
  color: white;
  isolation: isolate;
}

.parallax-layer {
  position: absolute;
  inset: -10%;
  z-index: -3;
  background:
    radial-gradient(circle at 75% 35%, rgba(201,166,107,.28), transparent 30%),
    linear-gradient(135deg, #415d4a, #16241c);
  background-attachment: fixed;
  background-size: cover;
  background-position: center;
}

.parallax-layer::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(115deg, transparent 0 60%, rgba(255,255,255,.045) 60% 61%, transparent 61%),
    linear-gradient(25deg, transparent 0 70%, rgba(255,255,255,.035) 70% 71%, transparent 71%);
}

.missions-overlay {
  position: absolute;
  inset: 0;
  z-index: -2;
  background: linear-gradient(90deg, rgba(10,20,14,.86), rgba(10,20,14,.32));
}

.missions-content {
  width: min(720px, 84vw);
  margin-left: 10vw;
}

.missions-content h2 {
  font-size: clamp(3.8rem, 6.5vw, 7rem);
}

.missions-content h2 span {
  color: #dec7a0;
}

.missions-content > p {
  max-width: 600px;
  margin-top: 30px;
  line-height: 1.8;
  color: rgba(255,255,255,.75);
}

.mission-links {
  margin: 38px 0;
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.mission-links a {
  padding: 11px 16px;
  border: 1px solid rgba(255,255,255,.25);
  font-size: 11px;
}

.light-button {
  background: var(--cream);
  color: var(--ink);
}

.events-section {
  background: var(--cream);
}

.events-list {
  border-top: 1px solid var(--line);
}

.event-row {
  min-height: 145px;
  display: grid;
  grid-template-columns: 150px 1fr 50px;
  align-items: center;
  border-bottom: 1px solid var(--line);
  transition: padding .25s ease;
}

.event-row:hover {
  padding-left: 14px;
}

.event-date span,
.event-date strong {
  display: block;
}

.event-date span {
  font-size: 10px;
  letter-spacing: .15em;
  color: #836b45;
}

.event-date strong {
  font-family: var(--font-serif), Georgia, serif;
  font-size: 48px;
  font-weight: 500;
}

.event-details h3 {
  font-family: var(--font-serif), Georgia, serif;
  font-size: 30px;
  font-weight: 500;
}

.event-details p {
  margin-top: 6px;
  color: var(--muted);
  font-size: 13px;
}

.event-row > a {
  font-size: 25px;
}

.worship-section {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  min-height: 720px;
}

.worship-image {
  padding: 70px;
  background: #24352b;
}

.image-placeholder {
  width: 100%;
  height: 100%;
  min-height: 560px;
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    linear-gradient(145deg, rgba(201,166,107,.18), transparent),
    #31473a;
  border: 1px solid rgba(255,255,255,.14);
}

.image-placeholder span {
  color: rgba(255,255,255,.35);
  font-size: 10px;
  letter-spacing: .25em;
}

.worship-content {
  padding: 100px 8vw;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.worship-content h2 {
  font-size: clamp(3.5rem, 5vw, 6rem);
}

.worship-content h2 span {
  color: #95774f;
}

.worship-content p {
  margin-top: 30px;
  color: var(--muted);
  line-height: 1.8;
}

.giving-section {
  padding: 120px 9vw;
  background: var(--forest);
  color: white;
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  gap: 80px;
  align-items: end;
}

.giving-section h2 {
  font-size: clamp(3.5rem, 5.5vw, 6.5rem);
}

.giving-section h2 span {
  color: #e0c79e;
}

.giving-section > div:last-child p {
  margin-bottom: 30px;
  max-width: 500px;
  line-height: 1.8;
  color: rgba(255,255,255,.72);
}

.visit-section {
  padding: 150px 20px;
  text-align: center;
}

.visit-section h2 {
  margin: 0 auto 40px;
  font-size: clamp(4rem, 7vw, 8rem);
}

.visit-section h2 span {
  color: #9b7e54;
}

.dark-button {
  background: var(--ink);
  color: white;
}

footer {
  padding: 70px 7vw;
  background: #101713;
  color: white;
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: 50px;
}

footer strong,
footer span,
footer a,
footer p {
  display: block;
}

footer span {
  margin-bottom: 10px;
  color: rgba(255,255,255,.42);
  font-size: 9px;
  letter-spacing: .16em;
  text-transform: uppercase;
}

footer strong {
  font-family: var(--font-serif), Georgia, serif;
  font-size: 22px;
}

footer p,
footer a {
  margin-bottom: 7px;
  color: rgba(255,255,255,.67);
  font-size: 12px;
}

.footer-brand strong {
  font-size: 34px;
}

@media (max-width: 950px) {
  .desktop-nav {
    display: none;
  }

  .site-header {
    height: 88px;
  }

  .hero h1 {
    font-size: clamp(4rem, 12vw, 7rem);
  }

  .service-strip {
    grid-template-columns: 1fr 1fr;
  }

  .service-strip div {
    border-right: 0;
  }

  .intro-section {
    grid-template-columns: 1fr;
    gap: 25px;
    padding: 100px 7vw;
  }

  .section-number {
    font-size: 45px;
  }

  .intro-copy {
    padding-top: 0;
  }

  .section-heading {
    align-items: start;
    flex-direction: column;
  }

  .ministry-grid {
    grid-template-columns: 1fr;
  }

  .ministry-card {
    min-height: 280px;
    border-right: 0;
    border-bottom: 1px solid var(--line);
  }

  .worship-section,
  .giving-section {
    grid-template-columns: 1fr;
  }

  footer {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 650px) {
  .header-button {
    display: none;
  }

  .hero-content {
    margin-top: 90px;
  }

  .hero h1 {
    font-size: clamp(3.5rem, 17vw, 5.5rem);
  }

  .hero-actions {
    align-items: flex-start;
    flex-direction: column;
  }

  .scroll-indicator {
    display: none;
  }

  .service-strip {
    grid-template-columns: 1fr;
    padding: 35px 7vw;
  }

  .service-strip > div {
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
  }

  .ministries-section,
  .events-section {
    padding: 90px 7vw;
  }

  .missions-content {
    margin-left: 7vw;
  }

  .parallax-layer {
    background-attachment: scroll;
  }

  .event-row {
    grid-template-columns: 90px 1fr 25px;
  }

  .event-date strong {
    font-size: 38px;
  }

  .event-details h3 {
    font-size: 23px;
  }

  .worship-image {
    padding: 25px;
  }

  .image-placeholder {
    min-height: 420px;
  }

  .worship-content,
  .giving-section {
    padding: 90px 7vw;
  }

  footer {
    grid-template-columns: 1fr;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
  }

  .parallax-layer {
    background-attachment: scroll;
  }
}

