/* =========================================================
   OVERSIZED SALT & LIGHT WATERMARK
   Dark interior page sections
   ========================================================= */

.simple-page-header,
.interior-hero,
.interior-cta {
  position: relative;
  isolation: isolate;
  overflow: hidden;
}

.simple-page-header::before,
.interior-hero::before,
.interior-cta::before {
  content: "";
  position: absolute;
  width: min(760px, 68vw);
  aspect-ratio: 1;
  right: -8vw;
  top: 50%;
  transform: translateY(-50%);
  background-image: url("/images/brand/salt-and-light-mark.svg");
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  opacity: 0.045;
  filter: grayscale(1) brightness(2.1);
  pointer-events: none;
  z-index: -1;
}

/* Keep content above watermark */
.simple-page-header > *,
.interior-hero > *,
.interior-cta > * {
  position: relative;
  z-index: 1;
}

/* Slightly different placement for image heroes */
.interior-hero::before {
  width: min(680px, 60vw);
  right: 1vw;
  opacity: 0.035;
}

/* CTA can carry a larger centered mark */
.interior-cta::before {
  width: min(820px, 72vw);
  right: 50%;
  transform: translate(50%, -50%);
  opacity: 0.04;
}

@media (max-width: 950px) {
  .simple-page-header::before,
  .interior-hero::before,
  .interior-cta::before {
    width: min(600px, 80vw);
    right: -18vw;
  }

  .interior-cta::before {
    right: 50%;
  }
}

@media (max-width: 650px) {
  .simple-page-header::before,
  .interior-hero::before,
  .interior-cta::before {
    width: 105vw;
    right: -42vw;
    opacity: 0.035;
  }

  .interior-cta::before {
    right: 50%;
    opacity: 0.03;
  }
}
